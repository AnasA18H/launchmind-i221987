# LLM — set LLM_PROVIDER to anthropic | openai | groq and fill the matching key(s).
# Groq (recommended for speed): https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
# Optional: see https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional runtime
# STARTUP_IDEA=A one-line idea if you run `python main.py` with no args
# ENABLE_QA=true
# MAX_PRODUCT_REVISIONS=4
# MAX_ENGINEER_REVISIONS=3
# GITHUB_BASE_BRANCH=main
# GITHUB_LANDING_PATH=index.html

# GitHub — classic PAT with repo scope; repo as owner/name
GITHUB_TOKEN=
GITHUB_REPO=your-org/launchmind-your-group

# Slack — Bot User OAuth Token; channel #name or channel ID (C…)
# Create #launches in the workspace, invite the bot, or paste channel ID from Slack.
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_CHANNEL=#launches

# SendGrid — verified sender and test recipient
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=verified@yourdomain.com
TEST_EMAIL=you@example.com
