# LLM (set at least one provider)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Prefer anthropic | openai
LLM_PROVIDER=anthropic

# Optional runtime
# STARTUP_IDEA=A one-line idea if you run `python main.py` with no args
# ENABLE_QA=true
# MAX_PRODUCT_REVISIONS=4
# MAX_ENGINEER_REVISIONS=3
# GITHUB_BASE_BRANCH=main
# GITHUB_LANDING_PATH=index.html

# GitHub — classic PAT with repo scope; repo as owner/name
GITHUB_TOKEN=
GITHUB_REPO=your-org/launchmind-your-group

# Slack — Bot User OAuth Token; channel name or ID
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_CHANNEL=#launches

# SendGrid — verified sender and test recipient
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=verified@yourdomain.com
TEST_EMAIL=you@example.com
